# ---- Database (PostgreSQL) ----
# Local dev: a local Postgres, or a Neon dev branch.
# Vercel + Neon: use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Session ----
# Signs session cookies AND encrypts stored Brightspace tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# ---- Sign-up ----
# Registration is CLOSED unless this is set. Anyone with this code can create an
# account, so treat it like a password and change it to revoke access.
INVITE_CODE=""

# ---- Brightspace integration ----
# off  = manual mode (default): no sync, everything entered by hand
# mock = demo data, for local development only — never in production
# live = real Brightspace via OAuth 2.0 (needs the variables below)
BRIGHTSPACE_MODE="off"

# Required only when BRIGHTSPACE_MODE=live. See docs/BRIGHTSPACE.md.
BRIGHTSPACE_BASE_URL=""
BRIGHTSPACE_CLIENT_ID=""
BRIGHTSPACE_CLIENT_SECRET=""
BRIGHTSPACE_REDIRECT_URI=""
BRIGHTSPACE_SCOPES="core:*:*"
