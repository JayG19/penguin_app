# SQLite database file (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=""

# ---- Brightspace integration (leave empty for demo mode) ----
# Mode: "mock" (demo data) or "live" (real Brightspace OAuth2 API)
BRIGHTSPACE_MODE="mock"
# Your institution's Brightspace host, e.g. https://uottawa.brightspace.com
BRIGHTSPACE_BASE_URL=""
# OAuth 2.0 app credentials registered in Brightspace (Admin Tools > Manage Extensibility > OAuth 2.0)
BRIGHTSPACE_CLIENT_ID=""
BRIGHTSPACE_CLIENT_SECRET=""
# Redirect URI registered with the app, e.g. http://localhost:3000/api/brightspace/callback
BRIGHTSPACE_REDIRECT_URI=""
# Space-separated scopes, e.g. "core:*:* content:*:* grades:*:*"
BRIGHTSPACE_SCOPES="core:*:*"
